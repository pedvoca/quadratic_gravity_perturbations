Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Defining", " ", "background", " ", "manifold"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DefManifold", "[", 
     RowBox[{"M", ",", "4", ",", 
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "\[Mu]", ",", 
        "\[Nu]", ",", "\[Lambda]", ",", "\[Sigma]"}], "}"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Defining", " ", "the", " ", "background", " ", "metric", " ", "to", " ", 
     "be", " ", "perturbed"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefMetric", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"-", "\[Alpha]"}], ",", 
        RowBox[{"-", "\[Beta]"}]}], "]"}], ",", "CD", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<;\>\"", ",", "\"\<\!\(\*OverscriptBox[\(\[Del]\), \(_\)]\)\>\""}],
        "}"}], ",", 
      RowBox[{
      "PrintAs", "\[Rule]", "\"\<\!\(\*OverscriptBox[\(g\), \(_\)]\)\>\""}]}],
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Defining", " ", "the", " ", "3"}], "+", 
      RowBox[{
      "1", " ", "spliting", " ", "of", " ", "the", " ", "spacetime"}]}], ";", 
     " ", 
     RowBox[{
     "one", " ", "can", " ", "choose", " ", "from", " ", "many", " ", 
      "homogeneous", " ", "metrics", " ", "that", " ", "admits", " ", "a", 
      " ", "well", " ", "defined", " ", "split"}], ";", " ", 
     RowBox[{"also", " ", "defines", " ", "metric"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"SetSlicing", "[", 
    RowBox[{"g", ",", "n", ",", "h", ",", "cd", ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<|\>\"", ",", "\"\<\!\(\*OverscriptBox[\(D\), \(_\)]\)\>\""}], 
      "}"}], ",", "\"\<FLFlat\>\""}], "]"}]}]}]], "Input",
