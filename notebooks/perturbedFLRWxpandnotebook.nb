Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Defining", " ", "useful", " ", "functions", " ", "to", " ", "organize", 
    " ", "and", " ", "contract", " ", "tensor", " ", "algebra"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"org", "[", "expr_", "]"}], ":=", 
     RowBox[{"ScreenDollarIndices", "@", 
      RowBox[{"NoScalar", "@", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"ContractMetric", "[", "expr", "]"}], ",", 
         "$PerturbationParameter", ",", "ToCanonical"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"collect", "[", "expr_", "]"}], ":=", 
    RowBox[{"ScreenDollarIndices", "@", 
     RowBox[{"NoScalar", "@", 
      RowBox[{"Collect", "[", 
       RowBox[{"expr", ",", "$PerturbationParameter", ",", "ContractMetric"}],
        "]"}]}]}]}]}]}]], "Input",
 CellChangeTimes->{
  3.875871387721529*^9, {3.875871666270627*^9, 3.875871674370326*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"cafeb67e-22f8-4dec-b59d-5b6314e375bc"],

