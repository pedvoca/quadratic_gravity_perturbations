Cell["\<\
The velocity grid fixes the scalar velocity potential used below.  Vector \
modes have been removed, so its spatial projection is completely described by \
the scalar field printed as v.\
\>", "Text",ExpressionUUID->"ba5c4b47-8f5a-4868-8093-2916dcc9e088"],

Cell[CellGroupData[{

Cell["Algebraic checks", "Subsection",ExpressionUUID->"cd5927d3-398b-483f-a9ba-ebb10947fbed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lagrangianCheck", " ", "=", " ", 
   RowBox[{"qgLagrangian", " ", "===", " ", 
    RowBox[{
     RowBox[{"RicciScalarCD", "[", "]"}], " ", "+", " ", 
     RowBox[{"qgAlpha", " ", 
      RowBox[{
       RowBox[{"RicciScalarCD", "[", "]"}], "^", "2"}]}], " ", "+", " ", 
     RowBox[{"qgBeta", " ", 
      RowBox[{"WeylCD", "[", 
       RowBox[{
        RowBox[{"-", "\[Alpha]"}], ",", " ", 
        RowBox[{"-", "\[Beta]"}], ",", " ", 
        RowBox[{"-", "\[Gamma]"}], ",", " ", 
        RowBox[{"-", "\[Lambda]"}]}], "]"}], " ", 
      RowBox[{"WeylCD", "[", 
       RowBox[{
       "\[Alpha]", ",", " ", "\[Beta]", ",", " ", "\[Gamma]", ",", " ", 
        "\[Lambda]"}], "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"einsteinLimitCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{"ToCanonical", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"qgEOM", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"qgAlpha", " ", "->", " ", "0"}], ",", " ", 
          RowBox[{"qgBeta", " ", "->", " ", "0"}]}], "}"}]}], ")"}], " ", "-",
       " ", "einsteinTerm"}], "]"}], " ", "===", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scalarOnlyCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{"$FirstOrderVectorPerturbations", " ", "===", " ", "False"}], " ",
     "&&", " ", 
    RowBox[{"$FirstOrderTensorPerturbations", " ", "===", " ", "False"}]}]}], 
  ";"}], "\n", 
 RowBox[{"qgResult", "[", 
  RowBox[{"\"\<Consistency checks\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Lagrangian definition\>\"", ",", " ", "lagrangianCheck"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Einstein limit  (alpha = beta = 0)\>\"", ",", " ", 
       "einsteinLimitCheck"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Scalar sector only\>\"", ",", " ", "scalarOnlyCheck"}], 
      "}"}]}], "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[44]:=",ExpressionUUID->"10437082-69ef-4be9-9921-de2469a4d162"],

