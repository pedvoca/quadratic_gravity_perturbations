Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qgEOMBackground", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"einsteinBackground", " ", "+", " ", 
      RowBox[{"qgAlpha", " ", "rSquaredBackground"}], " ", "+", " ", 
      RowBox[{"qgBeta", " ", "weylSquaredBackground"}]}], ")"}], " ", "//", 
    " ", "ToCanonical"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qgEOMLinear", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"einsteinLinear", " ", "+", " ", 
       RowBox[{"qgAlpha", " ", "rSquaredLinear"}], " ", "+", " ", 
       RowBox[{"qgBeta", " ", "weylSquaredLinear"}]}], ")"}], " ", "//", " ", 
     "ToCanonical"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"backgroundQGComponents", " ", "=", " ", 
   RowBox[{"ExtractComponents", "[", 
    RowBox[{"qgEOMBackground", ",", " ", "h"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linearQGComponents", " ", "=", " ", 
    RowBox[{"ExtractComponents", "[", 
     RowBox[{"qgEOMLinear", ",", " ", "h"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Read", " ", "each", " ", "pair", " ", "as", " ", "E_QG"}], " ", 
     "=", " ", 
     RowBox[{"T_dust", " ", "in", " ", "the", " ", "nn"}]}], ",", " ", "nh", ",",
     " ", 
    RowBox[{"and", " ", "hh", " ", 
     RowBox[{"blocks", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"qgTensorResult", "[", 
  RowBox[{"\"\<Full QG-dust equations: compare like-labelled components\>\"", 
   ",", " ", 
