Cell[CellGroupData[{

Cell["Dust stress-energy tensor", "Section",ExpressionUUID->"70db7ebf-1a23-4c63-9984-3fa3566155a7"],

Cell["\<\
xPand's DefMatterFields has already defined the density rho[u] and the scalar \
velocity potential.  For dust, p = delta p = 0, so T_mn = rho u_m u_n.  The \
following cell makes the background density, its first perturbation, and the \
density contrast explicit before splitting the tensor.\
\>", "Text",ExpressionUUID->"355fb800-51c0-45d3-aa91-4aab6d1d523e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "\[Rho]u", "]"}], " ", "^=", 
   " ", "\"\<\[Rho]\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrintAs", "[", "Vshu", "]"}], " ", "^=", " ", "\"\<v\>\""}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"rhoBar", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Rho]", "[", "u", "]"}], "[", 
    RowBox[{
     RowBox[{"LI", "[", "0", "]"}], ",", " ", 
     RowBox[{"LI", "[", "0", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Rho]", "[", "u", "]"}], "[", 
    RowBox[{
     RowBox[{"LI", "[", "1", "]"}], ",", " ", 
     RowBox[{"LI", "[", "0", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"densityContrast", " ", "=", " ", 
    RowBox[{"deltaRho", "/", "rhoBar"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"p", " ", "=", " ", 
    RowBox[{
     RowBox[{
     "0", " ", "at", " ", "background", " ", "and", " ", "perturbative", " ", 
      
      RowBox[{"order", ":", " ", "T_mn"}]}], " ", "=", " ", 
     RowBox[{"rho", " ", "u_m", " ", 
      RowBox[{"u_n", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dustStressDown", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "u", "]"}], "[", "]"}], " ", 
    RowBox[{"u", "[", 
     RowBox[{"-", "\[Mu]"}], "]"}], " ", 
    RowBox[{"u", "[", 
     RowBox[{"-", "\[Nu]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dustStressUp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "u", "]"}], "[", "]"}], " ", 
    RowBox[{"u", "[", "\[Mu]", "]"}], " ", 
    RowBox[{"u", "[", "\[Nu]", "]"}]}]}], ";"}], "\n", 
 RowBox[{"qgResult", "[", 
  RowBox[{"\"\<Dust variables and stress tensor\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Background density  rho_bar\>\"", ",", " ", "rhoBar"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Density perturbation  delta rho\>\"", ",", " ", 
       "deltaRho"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Density contrast  delta = delta rho/rho_bar\>\"", ",", " ",
        "densityContrast"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Covariant dust tensor  T_mu nu\>\"", ",", " ", 
       "dustStressDown"}], "}"}]}], "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[48]:=",ExpressionUUID->"719fac0b-0422-4631-be42-30be6bdd35f0"],

