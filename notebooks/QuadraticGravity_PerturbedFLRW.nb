Cell["\<\
The R-squared and Weyl-squared coefficients in this cell follow directly from \
the respective xPand sectors.  In particular, the traceless ij Weyl \
coefficient is -beta/6; using -beta/2 would not be compatible with the nn \
Weyl projection or with the covariant QG equation.\
\>", "Text",ExpressionUUID->"55c544e9-5063-434c-9d87-d9e830a3f91c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fourier-space equation and gravitational slip", "Subsection",ExpressionUUID->"a0c21ca9-18ed-4f43-91bf-9daa42190a54"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fourier00Equation", " ", "=", " ", 
   RowBox[{
    RowBox[{"subHorizon", "[", "reduced00Equation", "]"}], " ", "//", " ", 
    "Expand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ijScalarEquation", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}], " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "-", " ", "phiSH"}], ")"}]}], " ", "+", " ", 
     RowBox[{"qgAlpha", " ", "boxSH", " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "-", " ", 
        RowBox[{"2", " ", "phiSH"}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"qgBeta", "/", "6"}], " ", "boxSH", " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "+", " ", "phiSH"}], ")"}]}]}], " ", "==", " ", 
    "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fourierIJScalarEquation", " ", "=", " ", 
   RowBox[{
    RowBox[{"subHorizon", "[", "ijScalarEquation", "]"}], " ", "//", " ", 
    "Expand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"slipRule", " ", "=", " ", 
   RowBox[{"First", " ", "@", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{"fourierIJScalarEquation", ",", " ", "psiSH"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"slipFourierEquation", " ", "=", " ", 
   RowBox[{"psiSH", " ", "==", " ", 
    RowBox[{"Factor", "[", 
     RowBox[{"psiSH", " ", "/.", " ", "slipRule"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"slipCheck", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"fourierIJScalarEquation", " ", "/.", " ", "slipRule"}], "]"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{"qgResult", "[", 
  RowBox[{"\"\<Fourier-space equations and gravitational slip\>\"", ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<00 equation  (Box -> -q)\>\"", ",", " ", 
       "fourier00Equation"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Traceless ij equation\>\"", ",", " ", 
       "fourierIJScalarEquation"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Slip relation  Psi(Phi,q)\>\"", ",", " ", 
       "slipFourierEquation"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Substitution check\>\"", ",", " ", "slipCheck"}], "}"}]}], 
    "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[133]:=",ExpressionUUID->"485c59c4-dca8-4e79-a5b7-b45ebc3fb30b"],

