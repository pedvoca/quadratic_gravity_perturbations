Cell["\<\
For nonzero alpha beta, the infrared limit is {1, -1/2, 1/(8 pi)} and the \
ultraviolet limit is {(6 alpha-beta)/(12 alpha+beta), 0, 0}.  The beta -> 0 \
(pure f(R)) limit must be taken separately: it is not the same as the generic \
alpha beta ultraviolet limit.\
\>", "Text",ExpressionUUID->"c5bbffd7-fb90-4a87-8c0d-7c5828a76e9a"]
}, Open  ]]
}, Open  ]]
