Cell["\<\
Here dots denote cosmic-time derivatives, q = k^2/a^2, and the usual \
conversion from the xPand conformal-time output is d/deta = a d/dt and calH = \
a H.  The dust continuity and Euler equations are the normal and spatial \
projections of dustConservation above; together they give the displayed \
growth equation after the same leading-gradient reduction.\
\>", "Text",ExpressionUUID->"f2f2f167-ea5f-4dc0-a224-75cfb17888dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"infraredLimit", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"QSH", ",", " ", "fQSH", ",", " ", "geffSH"}], "}"}], ",", " ", 
      RowBox[{"qSH", " ", "->", " ", "0"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ultravioletLimit", " ", "=", " ", 
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"qgAlpha", " ", "qgBeta"}], " ", "!=", " ", "0"}], ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"QSH", ",", " ", "fQSH", ",", " ", "geffSH"}], "}"}], ",", 
         " ", 
         RowBox[{"qSH", " ", "->", " ", "Infinity"}]}], "]"}], "]"}]}], 
     "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Present", " ", "the", " ", "slip", " ", "in", " ", "the", " ", "same", " ",
     "rational", " ", "form", " ", "used", " ", "in", " ", "the", " ", 
    "slides", " ", "and", " ", 
    RowBox[{"manuscript", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ultravioletLimit", "[", 
    RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"Together", "[", 
     RowBox[{"ultravioletLimit", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"qgResult", "[", 
  RowBox[{"\"\<Infrared and ultraviolet limits\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<q -> 0:  {Q, f_Q, G_eff}\>\"", ",", " ", "infraredLimit"}],
       "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<q -> Infinity, with alpha beta != 0:  {Q, f_Q, G_eff}\>\"",
        ",", " ", "ultravioletLimit"}], "}"}]}], "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[156]:=",ExpressionUUID->"39136956-abe9-4feb-a382-9cfcd591d491"],

