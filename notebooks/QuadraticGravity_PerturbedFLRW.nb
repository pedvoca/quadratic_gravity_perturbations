Cell["Leading-derivative projection of each xPand sector", "Subsection",ExpressionUUID->"9059ef5d-577f-44e0-b0b7-ddf218c92882"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "These", " ", "are", " ", "the", " ", "nn", " ", "and", " ", 
      "traceless"}], "-", 
     RowBox[{"hh", " ", "projections", " ", "of", " ", "einsteinLinear"}]}], ",",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "rSquaredLinear", " ", "and", " ", "weylSquaredLinear", " ", "after", " ",
        "the", " ", "local", " ", "conformally"}], "-", 
      RowBox[{"flat", "/", "sub"}], "-", 
      RowBox[{"horizon", " ", 
       RowBox[{"reduction", ".", "  ", "dijTF"}], " ", "denotes", " ", "the", 
       " ", "nonzero", " ", "traceless", " ", "scalar", " ", "operator", " ", 
       "partial_"}]}], "<", 
     RowBox[{"i", " ", "partial_j"}], ">", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"einstein00SH", " ", "=", " ", 
     RowBox[{"2", " ", "boxSH", " ", "phiSH"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rSquared00SH", " ", "=", " ", 
     RowBox[{"4", " ", 
      RowBox[{"boxSH", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "-", " ", 
        RowBox[{"2", " ", "phiSH"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"weylSquared00SH", " ", "=", " ", 
     RowBox[{
      RowBox[{"4", "/", "3"}], " ", 
      RowBox[{"boxSH", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "+", " ", "phiSH"}], ")"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"reduced00Equation", " ", "=", " ", 
     RowBox[{
      RowBox[{"einstein00SH", " ", "+", " ", 
       RowBox[{"qgAlpha", " ", "rSquared00SH"}], " ", "+", " ", 
       RowBox[{"qgBeta", " ", "weylSquared00SH"}]}], " ", "==", " ", 
      "deltaRhoSH"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "hh", " ", "equation", " ", "is", " ", "divided", " ", "by", 
      " ", "four"}], ",", " ", 
     RowBox[{
      RowBox[{"as", " ", "in", " ", "the", " ", "readable", " ", "off"}], "-", 
      RowBox[{"diagonal", " ", "ij", " ", "presentation", " ", 
       RowBox[{"equation", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"einsteinijSH", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}], " ", "dijTF", " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "-", " ", "phiSH"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rSquaredijSH", " ", "=", " ", 
     RowBox[{"dijTF", " ", "boxSH", " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "-", " ", 
        RowBox[{"2", " ", "phiSH"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"weylSquaredijSH", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "6"}], " ", "dijTF", " ", "boxSH", " ", 
      RowBox[{"(", 
       RowBox[{"psiSH", " ", "+", " ", "phiSH"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reducedijEquation", " ", "=", " ", 
     RowBox[{
      RowBox[{"einsteinijSH", " ", "+", " ", 
       RowBox[{"qgAlpha", " ", "rSquaredijSH"}], " ", "+", " ", 
       RowBox[{"qgBeta", " ", "weylSquaredijSH"}]}], " ", "==", " ", "0"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"qgResult", "[", 
    RowBox[{"\"\<Leading-derivative scalar equations\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<nn / 00 component\>\"", ",", " ", "reduced00Equation"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Traceless ij component\>\"", ",", " ", 
         "reducedijEquation"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[124]:=",ExpressionUUID->"82ca5328-cb2c-4c52-9b7b-dd2f2dbce5b6"],

