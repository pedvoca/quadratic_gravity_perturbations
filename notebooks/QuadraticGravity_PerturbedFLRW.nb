Cell[CellGroupData[{

Cell["Quadratic-gravity action", "Section",ExpressionUUID->"985700b8-418a-4632-8f09-9741acfd0a48"],

Cell["\<\
The action is Sg = Integral d^4x Sqrt[-g] LQG, with LQG = R + alpha R^2 + \
beta C_{abcd} C^{abcd}.  The following xAct expression is the scalar \
Lagrangian; the two subsequent cells display the individual metric-variation \
contributions before their sum is taken.\
\>", "Text",ExpressionUUID->"178af1d9-49d4-4e44-8e78-62b4c1a634e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Do", " ", "not", " ", "use", " ", "rho", " ", "as", " ", "an", " ", 
    "abstract", " ", 
    RowBox[{"index", ":", " ", 
     RowBox[{
     "xPand", " ", "reserves", " ", "rho", " ", "for", " ", "the", " ", 
      "matter", " ", "density", " ", 
      RowBox[{"field", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"DefManifold", "[", 
     RowBox[{"M", ",", " ", "4", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", " ", "\[Beta]", ",", " ", "\[Gamma]", ",", " ", 
        "\[Lambda]", ",", " ", "\[Mu]", ",", " ", "\[Nu]", ",", " ", 
        "\[Sigma]"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DefMetric", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"-", "\[Alpha]"}], ",", " ", 
        RowBox[{"-", "\[Beta]"}]}], "]"}], ",", " ", "CD", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}], "]"}], 
    ";"}], "\n", "\n", 
