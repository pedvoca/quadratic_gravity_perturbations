Cell["\<\
Expected final entry: 0.  With q = k^2/a^2 and Box -> -q, the notebook \
obtains Psi/Phi = (1 + 8 alpha q + (2/3) beta q)/(1 + 4 alpha q - (2/3) beta \
q).  This is the algebraic consequence of the preceding ij equation.\
\>", "Text",ExpressionUUID->"93a2d6f9-242c-48c4-b6a4-31c985452f3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Matter-growth equation", "Subsection",ExpressionUUID->"60502bc2-11ce-4d1d-bfef-520aeb6e87c9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "QSH", "]"}], " ", "^=", " ", "\"\<Q\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "fQSH", "]"}], " ", "^=", " ", "\"\<f_Q\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "fQSymbol", "]"}], " ", "^=", " ", "\"\<f_Q\>\""}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "deltaSH", "]"}], " ", "^=", 
   " ", "\"\<\[Delta]\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "deltaDotSH", "]"}], " ", "^=", 
   " ", "\"\<\\!\\(\\*OverscriptBox[\\(\[Delta]\\), \\(.\\)]\\)\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "deltaDDotSH", "]"}], " ", "^=", 
   " ", "\"\<\\!\\(\\*OverscriptBox[\\(\[Delta]\\), \\(..\\)]\\)\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "HSH", "]"}], " ", "^=", " ", "\"\<H\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrintAs", "[", "rhoMSH", "]"}], " ", "^=", 
    " ", "\"\<\\!\\(\\*SubscriptBox[\\(\[Rho]\\), \\(m\\)]\\)\>\""}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"QSH", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"phiSH", "/", 
     RowBox[{"(", 
      RowBox[{"psiSH", " ", "/.", " ", "slipRule"}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fQSH", " ", "=", " ", 
    RowBox[{"Factor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", "qgAlpha", " ", "qSH", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", " ", "QSH"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{"4", " ", "qgBeta", " ", 
         RowBox[{"qSH", "/", "3"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "QSH"}], ")"}]}], " ", "-", " ", 
        RowBox[{"2", " ", "QSH"}]}], ")"}]}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Keep", " ", "the", " ", "displayed", " ", "result", " ", "in", " ", 
     "the", " ", "compact", " ", "paper", " ", "notation"}], ";", " ", 
    RowBox[{
    "fQSH", " ", "above", " ", "is", " ", "the", " ", "fully", " ", 
     "substituted", " ", "expression", " ", "used", " ", "in", " ", "the", " ", 
     RowBox[{"limits", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"fQDefinition", " ", "=", " ", 
   RowBox[{"Defer", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", "qgAlpha", " ", "qSH", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", " ", "QSH"}]}], ")"}]}], " ", "+", " ", 
       RowBox[{"4", " ", "qgBeta", " ", 
        RowBox[{"qSH", "/", "3"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", "QSH"}], ")"}]}], " ", "-", " ", 
       RowBox[{"2", " ", "QSH"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"growthEquationSH", " ", "=", " ", 
   RowBox[{
    RowBox[{"deltaDDotSH", " ", "+", " ", 
     RowBox[{"2", " ", "HSH", " ", "deltaDotSH"}], " ", "+", " ", 
     RowBox[{"fQSH", " ", "rhoMSH", " ", "deltaSH"}]}], " ", "==", " ", 
    "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"growthEquationPaper", " ", "=", " ", 
   RowBox[{
    RowBox[{"deltaDDotSH", " ", "+", " ", 
     RowBox[{"2", " ", "HSH", " ", "deltaDotSH"}], " ", "+", " ", 
     RowBox[{"fQSymbol", " ", "rhoMSH", " ", "deltaSH"}]}], " ", "==", " ", 
    "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"geffSH", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "fQSH"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", " ", "Pi"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"geffPaper", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "fQSymbol"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", "Pi"}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"qgResult", "[", 
  RowBox[{"\"\<Matter growth and effective Newton coupling\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Gravitational slip  Q = Phi/Psi\>\"", ",", " ", "QSH"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Response coefficient  f_Q\>\"", ",", " ", "fQDefinition"}],
       "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Dust growth equation\>\"", ",", " ", 
       "growthEquationPaper"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Effective coupling  G_eff\>\"", ",", " ", "geffPaper"}], 
      "}"}]}], "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[140]:=",ExpressionUUID->"e952a150-95c9-4d5b-9d3e-2328caf6729b"],

