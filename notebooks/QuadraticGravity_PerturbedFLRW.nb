Cell["\<\
The normal component is the dust continuity equation and the spatial \
component is the Euler equation.  These expressions are obtained directly \
from nabla_mu T^(mu nu) = 0, rather than inserted as external assumptions.\
\>", "Text",ExpressionUUID->"0dd593c6-1d88-4b0a-805f-ea2357c7ebae"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Perturbed quadratic-gravity equations of motion", "Section",ExpressionUUID->"2765abaf-daed-45d6-8cf4-a254b553099b"],

Cell["\<\
Each geometric contribution is split and displayed separately.  This keeps \
the output readable and makes the origin of every term in the final QG \
equations transparent.  Run the three cells in order; the R^2 and especially \
the Weyl-squared sector are algebraically large.\
\>", "Text",ExpressionUUID->"f8ae7068-dca5-452d-a943-e83efb553f1d"],

Cell[CellGroupData[{

Cell["Einstein sector", "Subsection",ExpressionUUID->"c31c78f2-130d-47a8-b2a1-5b426961e398"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"einsteinFLRW", " ", "=", " ", 
   RowBox[{"MyToxPand", "[", 
    RowBox[{
    "einsteinTerm", ",", " ", "\"\<NewtonGauge\>\"", ",", " ", 
     "perturbationOrder"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"einsteinBackground", " ", "=", " ", 
   RowBox[{"zerothOrder", "[", "einsteinFLRW", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"einsteinLinear", " ", "=", " ", 
   RowBox[{"firstOrder", "[", "einsteinFLRW", "]"}]}], ";"}], "\n", 
 RowBox[{"qgTensorResult", "[", 
  RowBox[{"\"\<Einstein sector: xPand components\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Background  E^(EH,0)_mu nu\>\"", ",", " ", 
       RowBox[{"ExtractComponents", "[", 
        RowBox[{"einsteinBackground", ",", " ", "h"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Linear scalar part  delta E^(EH)_mu nu\>\"", ",", " ", 
       RowBox[{"ExtractComponents", "[", 
        RowBox[{"einsteinLinear", ",", " ", "h"}], "]"}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[71]:=",ExpressionUUID->"eeafd2d0-39a5-4b12-ae3b-33e897c70b16"],

