        RowBox[{"SplitMetric", "[", 
         RowBox[{
         "g", ",", " ", "dg", ",", " ", "h", ",", 
          " ", "\"\<NewtonGauge\>\""}], "]"}]}], ",", " ", "h"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"qgTensorResult", "[", 
