Cell["\<\
For comparison with the manuscript notation, the linear grids encode delta \
T_00 = delta rho, delta T_0i = rho v_i, and delta T_ij = 0 after converting \
the normal projections to the conformal-coordinate basis.  The scale-factor \
factors are retained by xPand rather than suppressed by hand.\
\>", "Text",ExpressionUUID->"ccc166db-2329-4599-b3ad-7878a074d78d"],

Cell[CellGroupData[{

Cell["Dust conservation equations", "Subsection",ExpressionUUID->"380a25db-d317-4eb8-bd8a-51ea5f5f95d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dustConservation", " ", "=", " ", 
   RowBox[{"MyToxPand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CD", "[", 
       RowBox[{"-", "\[Mu]"}], "]"}], "[", "dustStressUp", "]"}], ",", 
     " ", "\"\<NewtonGauge\>\"", ",", " ", "perturbationOrder"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dustConservationBackground", " ", "=", " ", 
   RowBox[{"zerothOrder", "[", "dustConservation", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dustConservationLinear", " ", "=", " ", 
   RowBox[{"firstOrder", "[", "dustConservation", "]"}]}], ";"}], "\n", 
 RowBox[{"qgTensorResult", "[", 
  RowBox[{"\"\<Dust conservation:  nabla_mu T^(mu nu) = 0\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Background\>\"", ",", " ", 
       RowBox[{"ExtractComponents", "[", 
        RowBox[{"dustConservationBackground", ",", " ", "h"}], "]"}]}], "}"}],
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Linear scalar perturbation\>\"", ",", " ", 
       RowBox[{"ExtractComponents", "[", 
        RowBox[{"dustConservationLinear", ",", " ", "h"}], "]"}]}], "}"}]}], 
    "}"}]}], "]"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[63]:=",ExpressionUUID->"a37a0d45-f9c5-49df-aee4-97dbda5a1d8e"],

