Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "psiSH", ",", "phiSH", ",", "boxSH", ",", "qSH", ",", "deltaRhoSH", ",", 
     "dijTF", ",", "einstein00SH", ",", "rSquared00SH", ",", 
     "weylSquared00SH", ",", "einsteinijSH", ",", "rSquaredijSH", ",", 
     "weylSquaredijSH"}], "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Reduced", " ", 
    RowBox[{"variables", ":", " ", 
     RowBox[{
      RowBox[{
      "Psi", " ", "is", " ", "the", " ", "temporal", " ", "potential", " ", 
       "and", " ", "Phi", " ", "the", " ", "spatial"}], "-", 
      RowBox[{"curvature", " ", 
       RowBox[{"potential", "."}]}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "psiSH", "]"}], "^=", "\"\<\[CapitalPsi]\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "phiSH", "]"}], "^=", "\"\<\[CapitalPhi]\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "boxSH", "]"}], "^=", "\"\<\[EmptySquare]\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "qSH", "]"}], "^=", "\"\<q\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "deltaRhoSH", "]"}], 
   "^=", "\"\<\[Delta]\[Rho]\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrintAs", "[", "dijTF", "]"}], 
    "^=", "\"\<\\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[LeftAngleBracket]ij\[RightAngleBracket]\\)]\\)\>\""}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Dictionary", " ", "for", " ", "the", " ", "preceding", " ", "xPand", " ", 
      RowBox[{"output", ":", "  ", 
       RowBox[{"Phi_h", " ", 
        RowBox[{"(", "lapse", ")"}]}]}]}], " ", "->", " ", "Psi"}], ",", " ", 
    
    RowBox[{
     RowBox[{"Psi_h", " ", 
      RowBox[{"(", 
       RowBox[{"spatial", " ", "curvature"}], ")"}]}], " ", "->", " ", 
     RowBox[{"Phi", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"potentialDictionary", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Phi_h\>\"", " ", "->", " ", "\"\<Psi\>\""}], ",", " ", 
      RowBox[{"\"\<Psi_h\>\"", " ", "->", " ", "\"\<Phi\>\""}]}], "}"}]}], 
   ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Conformally", "-", 
      RowBox[{
       RowBox[{"flat", "/", "local"}], " ", "and", " ", "sub"}], "-", 
      RowBox[{"horizon", " ", 
       RowBox[{"rules", ":", " ", 
        RowBox[{
        "a", " ", "local", " ", "a", " ", "is", " ", "retained", " ", "only", 
         " ", "through", " ", "q"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"k", "^", "2"}], "/", 
      RowBox[{"a", "^", "2"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{
     "time", " ", "derivatives", " ", "of", " ", "metric", " ", "potentials", 
      " ", "and", " ", "H"}], "-", 
     RowBox[{"suppressed", " ", "terms", " ", "are", " ", 
